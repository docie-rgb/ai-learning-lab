# 이 파일을 .env로 복사해서 값을 채운다. (.env는 Git에 올리지 않음)
PORT=3000

# 저장소 선택: sqlite(길 A, 로컬) 또는 supabase(길 B, 클라우드)
DB_PROVIDER=sqlite

# 길 A: 로컬 SQLite 파일 경로
DB_FILE=todo.db

# 길 B: Supabase 대시보드 → Project Settings → API Keys
#   SUPABASE_KEY에는 Publishable key(sb_publishable_...) 또는 Legacy anon key를 넣는다.
#   secret / service_role 키는 RLS를 무시하므로 절대 넣지 않는다.
SUPABASE_URL=
SUPABASE_KEY=

# RLS 확인 스크립트(npm run rls-check)용 테스트 계정 2개
TEST_A_EMAIL=
TEST_A_PASSWORD=
TEST_B_EMAIL=
TEST_B_PASSWORD=
